# Typed sequences share their element objects, even after a shallow copy.

class Node:
    value: Int

    def __init__(self, value: Int) -> None:
        self.value = value


def read_value(nodes: Seq[Node], index: Int) -> Int:
    return nodes[index].value


def set_value(nodes: Seq[Node], index: Int, value: Int) -> None:
    # @write
    nodes[index].value = value


def shallow_copy(nodes: Seq[Node]) -> Seq[Node]:
    return copy(nodes)

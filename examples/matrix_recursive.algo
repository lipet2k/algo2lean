# Eight-way matrix multiplication with correctness and Θ(n³) counted work for n = 2^k (CLRS 4.1).
# Matrices are arrays of integer rows; each output row is allocated independently.
# Output rows of c must be disjoint from all input rows and from one another
# within the output square. n is a positive power of two.
# The multiplication clock counts scalar integer multiplications.
# The calls clock counts all recursion nodes, including scalar leaves.
def matrix_block(a: Seq[Seq[Int]], b: Seq[Seq[Int]], c: Seq[Seq[Int]], stride: Int, row: Int, col: Int, inner: Int, n: Int) -> Int:
    tick("calls")
    if n <= 1:
        tick("multiplications")
        c[row][col] = c[row][col] + a[row][inner] * b[inner][col]
        return 0
    half = n // 2
    matrix_block(a, b, c, stride, row, col, inner, half)
    matrix_block(a, b, c, stride, row, col, inner + half, half)
    matrix_block(a, b, c, stride, row, col + half, inner, half)
    matrix_block(a, b, c, stride, row, col + half, inner + half, half)
    matrix_block(a, b, c, stride, row + half, col, inner, half)
    matrix_block(a, b, c, stride, row + half, col, inner + half, half)
    matrix_block(a, b, c, stride, row + half, col + half, inner, half)
    matrix_block(a, b, c, stride, row + half, col + half, inner + half, half)
    return 0


def matrix_recursive(a: Seq[Seq[Int]], b: Seq[Seq[Int]], n: Int) -> Seq[Seq[Int]]:
    c: Seq[Seq[Int]] = const(const(0))
    row = 0
    while row < n:
        c[row] = const(0)
        row += 1
    matrix_block(a, b, c, n, 0, 0, 0, n)
    return c

    change Rep h _ (strassen h (quadrants h A) (quadrants h B)).se at c22
    rw [strassen_quadrants] at c11 c12 c21 c22
    have joined := join_rep h _ _ _ _ (mul (h+h) A B) positive c11 c12 c21 c22

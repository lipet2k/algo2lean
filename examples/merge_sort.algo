# Stable merge sort of a finite interval within an infinite integer sequence.
# Indices are integers; [lo, hi) includes lo and excludes hi.
# Every element outside the interval keeps its original value.
# The merge_sort clock counts one unit per sort call and merged output element.
# copy(a) is an abstract constant-time snapshot of a mathematical sequence;
# the cost model excludes integer bit complexity and eager physical copying.


def merge(a: Seq, lo: Int, mid: Int, hi: Int) -> Seq:
    # The adjacent intervals [lo, mid) and [mid, hi) must already be sorted.
    # Clone a so stores to result cannot overwrite values still being read.
    result: Seq = copy(a)
    left: Int = lo
    right: Int = mid
    output: Int = lo

    # @both_remaining
    while left < mid and right < hi:
        # Taking the left value on equality makes the merge stable.
        if a[left] <= a[right]:
            result[output] = a[left]
            left += 1
        else:
            result[output] = a[right]
            right += 1
        output += 1
        tick("merge_sort")

    # @left_remaining
    while left < mid:
        result[output] = a[left]
        left += 1
        output += 1
        tick("merge_sort")

    # @right_remaining
    while right < hi:
        result[output] = a[right]
        right += 1
        output += 1
        tick("merge_sort")

    return result


def merge_sort(a: Seq, lo: Int, hi: Int) -> Seq:
    tick("merge_sort")
    # Empty, reversed, and one-element intervals need no changes.
    if hi - lo <= 1:
        return a

    mid: Int = lo + (hi - lo) // 2
    left_sorted: Seq = merge_sort(a, lo, mid)
    both_sorted: Seq = merge_sort(left_sorted, mid, hi)
    return merge(both_sorted, lo, mid, hi)


def demo_merge_sort() -> Seq:
    # Sort [3, 1, 4, 1] into [1, 1, 3, 4] on the interval [0, 4).
    a: Seq = const(0)
    a[-1] = 99
    a[0] = 3
    a[1] = 1
    a[2] = 4
    a[3] = 1
    a[4] = 77
    # The two markers outside the interval stay 99 and 77.
    return merge_sort(a, 0, 4)

from graph import Graph
from indexed_heap import MinHeap
from composable_dijkstra.dijkstra import dijkstra as search

# Bind generic Dijkstra to the independently verified indexed binary heap.
def dijkstra_binary(graph: Graph, source: Int) -> Seq:
    distance = const(-1)
    if source < 0 or source >= graph.size:
        return distance
    settled = const(0)
    queue = MinHeap()
    return search(graph, source, queue, distance, settled)

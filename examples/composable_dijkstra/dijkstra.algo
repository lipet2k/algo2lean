from graph import Graph, Edge
from composable_dijkstra.priority_queue import PriorityQueue

# The caller supplies a valid graph, an empty queue, a distance sequence filled
# with -1, and a separate settled sequence filled with 0. The source is in range.
# Recursive helpers expose reusable source-level summaries for the two loops.
# Queue storage is disjoint from both client sequences and the graph.

def scan_edges(queue: PriorityQueue, distance: Seq, settled: Seq,
               vertex: Int, edge: Edge | None) -> None:
    if edge is None:
        return
    tick("edges")
    target = edge.target
    if settled[target] == 0:
        candidate = distance[vertex] + edge.weight
        if distance[target] < 0 or candidate < distance[target]:
            # @improve
            distance[target] = candidate
            tick("queue_updates")
            queue.push_or_decrease(target, candidate)
            tick("improvements")
    return scan_edges(queue, distance, settled, vertex, edge.next)


def extract_all(graph: Graph, queue: PriorityQueue, distance: Seq, settled: Seq) -> Seq:
    # @extract
    tick("queue_empty_checks")
    if queue.is_empty():
        return distance
    tick("queue_pops")
    vertex = queue.pop_min()
    settled[vertex] = 1
    tick("settlements")
    scan_edges(queue, distance, settled, vertex, graph.heads[vertex])
    return extract_all(graph, queue, distance, settled)


def dijkstra(graph: Graph, source: Int, queue: PriorityQueue,
             distance: Seq, settled: Seq) -> Seq:
    distance[source] = 0
    tick("queue_updates")
    queue.push_or_decrease(source, 0)
    return extract_all(graph, queue, distance, settled)

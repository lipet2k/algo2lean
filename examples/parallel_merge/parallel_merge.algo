# CLRS fourth edition, Section 26.3: parallel merging and merge sort.
# Intervals use a starting index and a nonnegative length.
# Output and scratch arrays are allocated before entering a fork.


def binary_search(a: Seq, lo: Int, n: Int, key: Int) -> Int:
    # Return the first relative position whose value is at least key, or n.
    if n <= 0:
        return 0
    half: Int = n // 2
    if a[lo + half] < key:
        found: Int = binary_search(a, lo + half + 1, n - half - 1, key)
        return half + 1 + found
    return binary_search(a, lo, half, key)


def p_merge(a: Seq, lo1: Int, n1: Int, lo2: Int, n2: Int, out: Seq, dst: Int) -> Int:
    # Choose the median of the larger sorted interval, as in CLRS P-MERGE.
    if n1 < n2:
        saved_lo: Int = lo1
        lo1 = lo2
        lo2 = saved_lo
        saved_n: Int = n1
        n1 = n2
        n2 = saved_n
    if n1 <= 0:
        return 0
    half: Int = n1 // 2
    pivot: Int = a[lo1 + half]
    cut: Int = binary_search(a, lo2, n2, pivot)
    out[dst + half + cut] = pivot
    left, right = fork_join(
        p_merge(a, lo1, half, lo2, cut, out, dst),
        p_merge(a, lo1 + half + 1, n1 - half - 1, lo2 + cut, n2 - cut, out, dst + half + cut + 1)
    )
    return 0


def sort_into(a: Seq, lo: Int, n: Int, out: Seq, scratch: Seq) -> Int:
    # Two preallocated buffers alternate roles at consecutive recursion levels.
    if n <= 0:
        return 0
    if n == 1:
        out[lo] = a[lo]
        return 0
    half: Int = n // 2
    left, right = fork_join(
        sort_into(a, lo, half, scratch, out),
        sort_into(a, lo + half, n - half, scratch, out)
    )
    done: Int = p_merge(scratch, lo, half, lo + half, n - half, out, lo)
    return 0


def parallel_merge(a: Seq, lo1: Int, n1: Int, lo2: Int, n2: Int) -> Seq:
    # Merge two sorted input intervals into a fresh sequence beginning at zero.
    out: Seq = const(0)
    done: Int = p_merge(a, lo1, n1, lo2, n2, out, 0)
    return out


def parallel_merge_sort(a: Seq, lo: Int, n: Int) -> Seq:
    # Preserve a; return the sorted interval at the same indices in a fresh array.
    out: Seq = const(0)
    scratch: Seq = const(0)
    done: Int = sort_into(a, lo, n, out, scratch)
    return out

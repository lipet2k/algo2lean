# Strassen multiplication with correctness and Θ(n^(log₂ 7)) counted work for n = 2^k (CLRS 4.2).
# Preconditions: n = 2^depth for a natural depth; inputs have arbitrary Int entries.
# Every finite output row is fresh. Input matrices and their rows are never modified.

def matrix_linear_row(a: Seq[Int], b: Seq[Int], count: Int, sign: Int) -> Seq[Int]:
    c = const(0)
    i = 0
    # @loop
    while i < count:
        c[i] = a[i] + sign * b[i]
        tick("linear_cells")
        i += 1
    return c


def matrix_linear(a: Seq[Seq[Int]], b: Seq[Seq[Int]], count: Int, sign: Int) -> Seq[Seq[Int]]:
    c: Seq[Seq[Int]] = const(const(0))
    i = 0
    # @loop
    while i < count:
        c[i] = matrix_linear_row(a[i], b[i], count, sign)
        i += 1
    return c


def matrix_quadrant_row(a: Seq[Int], h: Int, column: Int) -> Seq[Int]:
    c = const(0)
    i = 0
    # @loop
    while i < h:
        c[i] = a[column + i]
        tick("copied_cells")
        i += 1
    return c


def matrix_quadrant(a: Seq[Seq[Int]], n: Int, h: Int, row: Int, column: Int) -> Seq[Seq[Int]]:
    c: Seq[Seq[Int]] = const(const(0))
    i = 0
    # @loop
    while i < h:
        c[i] = matrix_quadrant_row(a[row + i], h, column)
        i += 1
    return c


def matrix_join_row(a: Seq[Int], b: Seq[Int], h: Int) -> Seq[Int]:
    result = const(0)
    i = 0
    # @loop
    while i < h:
        result[i] = a[i]
        result[i + h] = b[i]
        tick("copied_cells", 2)
        i += 1
    return result


def matrix_join(a: Seq[Seq[Int]], b: Seq[Seq[Int]], c: Seq[Seq[Int]], d: Seq[Seq[Int]], h: Int) -> Seq[Seq[Int]]:
    result: Seq[Seq[Int]] = const(const(0))
    i = 0
    # @loop
    while i < h:
        result[i] = matrix_join_row(a[i], b[i], h)
        result[i + h] = matrix_join_row(c[i], d[i], h)
        i += 1
    return result


def strassen(a: Seq[Seq[Int]], b: Seq[Seq[Int]], n: Int) -> Seq[Seq[Int]]:
    tick("calls")
    if n <= 1:
        c: Seq[Seq[Int]] = const(const(0))
        c[0] = const(0)
        c[0][0] = a[0][0] * b[0][0]
        tick("products")
        return c
    else:
        h = n // 2
        a11 = matrix_quadrant(a, n, h, 0, 0)
        a12 = matrix_quadrant(a, n, h, 0, h)
        a21 = matrix_quadrant(a, n, h, h, 0)
        a22 = matrix_quadrant(a, n, h, h, h)
        b11 = matrix_quadrant(b, n, h, 0, 0)
        b12 = matrix_quadrant(b, n, h, 0, h)
        b21 = matrix_quadrant(b, n, h, h, 0)
        b22 = matrix_quadrant(b, n, h, h, h)
        # Seven recursive products replace the ordinary eight.
        p1 = strassen(a11, matrix_linear(b12, b22, h, -1), h)
        p2 = strassen(matrix_linear(a11, a12, h, 1), b22, h)
        p3 = strassen(matrix_linear(a21, a22, h, 1), b11, h)
        p4 = strassen(a22, matrix_linear(b21, b11, h, -1), h)
        p5 = strassen(matrix_linear(a11, a22, h, 1), matrix_linear(b11, b22, h, 1), h)
        p6 = strassen(matrix_linear(a12, a22, h, -1), matrix_linear(b21, b22, h, 1), h)
        p7 = strassen(matrix_linear(a11, a21, h, -1), matrix_linear(b11, b12, h, 1), h)
        c11 = matrix_linear(matrix_linear(matrix_linear(p5, p4, h, 1), p2, h, -1), p6, h, 1)
        c12 = matrix_linear(p1, p2, h, 1)
        c21 = matrix_linear(p3, p4, h, 1)
        c22 = matrix_linear(matrix_linear(matrix_linear(p5, p1, h, 1), p3, h, -1), p7, h, -1)
        return matrix_join(c11, c12, c21, c22, h)
